  rep("CNS", 14), 
  rep("NEP", 15),
  rep("Behavior", 2)
))

groups <- factor(as.character(groups), levels = c("Ideology","ENV","CNS", "NEP", "Behavior"))


plot(envBNetNetwork, layout = "spring", groups=groups, negDashed = T, legend = F, label.cex = .8, label.scale = T, details = F, theme = "gray")

```

