```

```{r}
betw_centO <- betw_cent %>% arrange(desc(mean))
close_centO <- close_cent %>% arrange(desc(mean))
str_centO <- str_cent %>% arrange(desc(mean))

cent_stat$itemtype[cent_stat$node1=="cns1" |
                     cent_stat$node1=="cns10" |
                     cent_stat$node1=="cns11" |
                     cent_stat$node1=="cns12_r" |
                     cent_stat$node1=="cns13" |
                     cent_stat$node1=="cns14_r" |
                     cent_stat$node1=="cns2" | 
                     cent_stat$node1=="cns3" |
                     cent_stat$node1=="cns4_r" |
                     cent_stat$node1=="cns5" |
                     cent_stat$node1=="cns6" |
                     cent_stat$node1=="cns7" |
                     cent_stat$node1=="cns8" |
                     cent_stat$node1=="cns9"] <- "CNS"

cent_stat$itemtype[cent_stat$node1=="nep1" |
                     cent_stat$node1=="nep10_r" |
                     cent_stat$node1=="nep11" |
                     cent_stat$node1=="nep12_r" |
                     cent_stat$node1=="nep13" |
                     cent_stat$node1=="nep14_r" |
                     cent_stat$node1=="nep15" |
                     cent_stat$node1=="nep2_r" |
                     cent_stat$node1=="nep3" |
                     cent_stat$node1=="nep4_r" |
                     cent_stat$node1=="nep5" |
                     cent_stat$node1=="nep6_r" |
                     cent_stat$node1=="nep7" |
                     cent_stat$node1=="nep8_r" |
                     cent_stat$node1=="nep9"] <- "NEP"

cent_stat$itemtype[cent_stat$node1=="Ideology"]  <- "Ideology"

cent_stat$itemtype[cent_stat$node1=="enviro.move" |
                     cent_stat$node1=="environmentalist"]  <- "ENV"

cent_stat$measure <- factor(as.character(cent_stat$type), levels = c("betweenness", "closeness", "strength"))
cent_stat$measure <- plyr::revalue(cent_stat$measure, c("betweenness" = "Betweenness",
                                                        "closeness" = "Closeness",
                                                        "strength" = "Strength"))
cent_stat$itemtype <- factor(as.character(cent_stat$itemtype), levels = c("NEP", "CNS", "Ideology", "ENV"))

centCOMP <- subset(cent_stat, itemtype=="CNS" | itemtype=="NEP")

# differences are not significant
btwCOMP.t <- t.test(mean ~ itemtype, data = subset(centCOMP, measure == "Betweenness"))
clsCOMP.t <- t.test(mean ~ itemtype, data = subset(centCOMP, measure == "Closeness"))
strCOMP.t <- t.test(mean ~ itemtype, data = subset(centCOMP, measure == "Strength"))

# functions for centrality by belief type plot
ci <- function(x) (sd(x)/sqrt(length(x))*qt(0.975,df=length(x)-1) ) #function to compute size of confidence intervals

data_summary <- function(x) {
  m <- mean(x)
  ymin <- m-ci(x)
  ymax <- m+ci(x)
  return(c(y=m,ymin=ymin,ymax=ymax))
}

centP <- ggplot(cent_stat, aes(x = factor(itemtype), y = mean)) +
  geom_point(size = 2, position=position_jitter(width=.05,height=0), alpha = .5) +
  facet_wrap(~measure, ncol = 3, scales = "free_y") +
  stat_summary(fun.data=data_summary, geom = "crossbar", size = .5, width = .3, color = "black")+
  ylab("Centrality")+
  theme_minimal() +
  theme(plot.title = element_text(face = "bold"),
        plot.caption = element_text(face = "italic"),
        axis.title.x=element_blank())

ggsave("output/centP.png", centP, width = 10, height = 4)

```


## Environmental Belief System Network with Behavior

```{r estimate complete network for environmental beliefs + behavior}
#| echo: false
#| warning: false

envBNetVars <- c("Ideology",
                "environmentalist", "enviro.move",
                "cns1","cns2","cns3","cns4_r","cns5","cns6","cns7",
                "cns8","cns9","cns10","cns11","cns12_r","cns13","cns14_r",
                "nep1","nep2_r","nep3","nep4_r","nep5","nep6_r","nep7","nep8_r",
                "nep9","nep10_r","nep11","nep12_r","nep13","nep14_r","nep15",
                "public","private")
envBNetData <- CCdata[envBNetVars]

envBNetNetwork <- estimateNetwork(envBNetData, 
                                 default = "EBICglasso",
                                 corMethod = "cor_auto",
                                 tuning = 0.5)

# summary(envBNetNetwork) ##for number of edges and connections
# partial correlation matrix
envBNetNetwork$results$optnet

pubCor <- envBNetNetwork$results$optnet[1:32,33] #public behave correlations 
privCor <- envBNetNetwork$results$optnet[1:32,34] #private behave correlations 



```

```{r plot env network + behavior}
#| message: false
#| results: asis
#| warning: false
#| echo: false
